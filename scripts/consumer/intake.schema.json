{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/factory-level/inferos/blob/main/scripts/consumer/intake.schema.json",
  "title": "InferOS customer intake",
  "description": "A reviewed customer intake (schema version 1), the input to `pnpm inferos intake apply`. scripts/consumer/intake.ts is the authoritative validator and also enforces the cross-references this schema cannot express: project keys in operations, pillars in operations, the wiki capability for selected pillars, each requirement category's capability, and unique ids.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "synthetic", "review", "customer", "inferops", "capabilities", "wiki", "operations", "requirements"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "synthetic": { "type": "boolean", "description": "True for invented sample data; reports and drafted issues carry the label." },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewedBy", "reviewedOn"],
      "properties": {
        "status": { "enum": ["reviewed", "draft"], "description": "intake apply refuses a draft." },
        "reviewedBy": { "$ref": "#/$defs/name" },
        "reviewedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f]*$" } }
    },
    "inferops": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant", "workspace", "projects"],
      "properties": {
        "tenant": { "$ref": "#/$defs/slug" },
        "workspace": { "$ref": "#/$defs/slug" },
        "projects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "name", "workflow"],
            "properties": {
              "key": { "$ref": "#/$defs/projectKey" },
              "name": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\u0000-\\u001f]*$" },
              "workflow": { "enum": ["software", "content"] }
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "enum": ["kanban", "wiki", "local-coding", "state-machine", "harness", "publish-widget", "publish-app", "agent-deployments"] }
    },
    "wiki": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pillars"],
      "properties": {
        "pillars": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": { "id": { "$ref": "#/$defs/slug" }, "title": { "$ref": "#/$defs/title" } }
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "owner", "project", "pillar", "sop"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "$ref": "#/$defs/title" },
          "owner": { "$ref": "#/$defs/name" },
          "project": { "$ref": "#/$defs/projectKey" },
          "pillar": { "oneOf": [{ "$ref": "#/$defs/slug" }, { "type": "null" }] },
          "sop": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f]*$" }, { "type": "null" }] }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "category"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "category": {
            "enum": ["kanban", "sign-in", "views", "wiki", "local-coding", "state-machine", "harness", "publish-widget", "publish-app", "agent-deployments", "deployment", "custom-component", "integration"]
          }
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "projectKey": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{1,9}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\u0000-\\u001f]*$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\u0000-\\u001f]*$" }
  }
}
