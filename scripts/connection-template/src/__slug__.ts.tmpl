// The __title__ connection package's Worker: vendor, account, verifier and the collection gatekeeper.
//
// Generated by `pnpm gatekeepers:scaffold __slug__`. This is a SCAFFOLD: its data source is
// `__Name__FakeProvider` (synthetic data in a Durable Object), reached through the typed client
// stub in `client.ts`. Nothing here talks to a real provider, and `connection.json` says
// `status: "scaffold"` until a person has reviewed the agent-facing contract (`types.d.ts`) and
// moved it on. See README.md for the steps.

import { DurableObject, RpcStub, RpcTarget, WorkerEntrypoint } from "cloudflare:workers";
import { skipRpcValidation, validateRpc } from "capnweb-validate";
import {
  ActionApplyError, ActionJournal, defineActions, type TaggedAction,
} from "@gadgets/gatekeeper-kit/actions";
import { createLogger } from "@gadgets/observability/logger";
import type {
  AccountDescription, ActionKind, ApprovalQueue, Gatekeeper, GatekeeperConnectCallback,
  GatekeeperConnectOptions, GatekeeperUser, GatekeeperUserVerifier, GitCache,
  ResourceConfiguratorFrame, ResourceDescription, SupportedResource, VendorDescription,
} from "@gadgets/workshop-shared/gatekeeper";
import { errorCode, openClient, type __Name__Client, type ErrorCode } from "./client";
import { __Name__FakeProvider } from "./fake-provider";
import type { __Name__CollectionSession, Item, ItemChanges, Revision } from "./types";
import TYPES_CODE from "./types.txt";

export { __Name__FakeProvider };

const VENDOR_ID = "__slug__";

type LogFields = { vendorId: string; collectionId: string; action: number; code: string };
const logger = createLogger<LogFields>({ component: "gatekeeper.__slug__", vendorId: VENDOR_ID });

// A plain square glyph; replace with the provider's own mark.
const ICON = {
  url: "data:image/svg+xml," + encodeURIComponent(
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 256 256' fill='currentColor'>" +
    "<rect x='40' y='40' width='176' height='176' rx='24'/></svg>"),
};

const NO_CONNECT_FLOW = "The __title__ connector is provided automatically; it has no connect flow.";
const MAX_TITLE = 200;

/** The one resource kind: a collection of items, bound by URL. */
const COLLECTION_RESOURCE: SupportedResource = {
  urlPattern: "__slug__://*/collection/*",
  title: "__title__ collection",
  description: "One __title__ collection: read its items and propose changes, each approved by you.",
  icon: ICON,
};

/** What the Workshop bakes into one binding when it mints it; the session never takes these. */
type BindingProps = { accountId: string; workspace: string; collectionId: string };

/** The props of one account, as the Workshop's stub for it carries them. */
type AccountProps = { accountId: string };

/** The workspace and collection a resource URL names, or an error saying why it names none. */
function parseCollectionUrl(url: string): { workspace: string; collectionId: string } {
  const match = /^__slug__:\/\/([a-z0-9-]+)\/collection\/([A-Za-z0-9_-]+)$/.exec(url);
  if (!match) throw new Error(`Not a __title__ collection URL: expected __slug__://<workspace>/collection/<id>.`);
  return { workspace: match[1]!, collectionId: match[2]! };
}

/** The message an agent sees for a provider refusal. Never echoes a value the agent sent. */
function refusal(code: ErrorCode | null): string {
  switch (code) {
    case "NOT_FOUND": return "NOT_FOUND: No such item in this collection.";
    case "STALE_REVISION": return "STALE_REVISION: The item changed after this was proposed; read it again.";
    case "INVALID_REQUEST": return "INVALID_REQUEST: The request was malformed.";
    case "UNAUTHORIZED": return "UNAUTHORIZED: This __title__ account was disconnected.";
    case "UNAVAILABLE": return "UNAVAILABLE: __title__ could not be reached; try again.";
    default: return "__title__ failed unexpectedly.";
  }
}

/** Errors known to have left nothing behind at the provider, so a retry can never succeed. */
const TERMINAL: ReadonlySet<ErrorCode> = new Set(["NOT_FOUND", "STALE_REVISION", "INVALID_REQUEST", "UNAUTHORIZED"]);

/** No HTTP surface: there is no connect flow, and everything else is RPC. */
export default {
  async fetch(): Promise<Response> {
    return new Response("Not Found", { status: 404 });
  },
};

// ---------------------------------------------------------------------------
// Actions

/** Every write this connector can be asked to make, by kind. */
type Actions = {
  updateItem: { itemId: string; changes: ItemChanges; expectedRevision: Revision };
};

/** What the action handlers may reach: the client and this binding's scope, never the DO itself. */
type Host = { client: __Name__Client; collectionId: string; idempotencyKey(actionId: number): string };

const actions = defineActions<Host, Actions>({
  updateItem: {
    kind: { tag: "update-item", label: "Update a __title__ item" },
    // No simulation: the agent waits for the decision instead of reading a pending change.
    delivery: "await-decision",
    describe: ({ itemId, changes, expectedRevision }) => ({
      title: `Update item ${itemId}`,
      description: `Sets the title of item \`${itemId}\` (revision ${expectedRevision}) to ` +
        `"${changes.title ?? ""}".`,
      descriptionIsComplete: true,
      implementsRevert: false,
    }),
    apply: async ({ itemId, changes, expectedRevision }, host, { id }) => {
      try {
        // The key is stable across retries, so a repeated or retried apply is answered by the
        // provider without writing twice.
        await host.client.updateItem(host.collectionId, itemId, changes, expectedRevision, host.idempotencyKey(id));
      } catch (error) {
        const code = errorCode(error);
        logger.warn("update failed", {
          event: "update.apply.failed", collectionId: host.collectionId, action: id, code: code ?? "UNKNOWN", error,
        });
        // Known to have changed nothing: terminal. Anything else stays pending and is retried.
        if (code && TERMINAL.has(code)) throw new ActionApplyError(refusal(code));
        throw new Error(refusal(code), { cause: error });
      }
    },
  },
}, {
  // Accounts are auto-provisioned and never reconnected, so there is no authority to fence on.
  fence: "none",
  vendorId: VENDOR_ID,
});

// ---------------------------------------------------------------------------
// Vendor

@validateRpc()
export class GatekeeperVendor extends WorkerEntrypoint<Cloudflare.Env> {
  async describe(): Promise<VendorDescription> {
    return {
      displayName: "__title__",
      url: "https://example.com/__slug__",
      logo: ICON,
      tagline: "Read __title__ collections and propose changes (scaffold, synthetic data)",
      description:
        "Gives Gadgets access to one __title__ collection at a time: read its items and propose " +
        "changes, each approved by you. This connector is a scaffold over synthetic data.",
      autoProvisionsAccount: true,
    };
  }

  /**
   * Mint an account with no user identity; its random id keys its own synthetic data. Return
   * validation is skipped: proxy-wrapping a WorkerEntrypoint stub breaks serialization.
   */
  @skipRpcValidation()
  async createAccount(): Promise<Fetcher<GatekeeperUser>> {
    return this.ctx.exports.__Name__Account({
      props: { accountId: crypto.randomUUID() },
    }) as unknown as Fetcher<GatekeeperUser>;
  }

  async connectAccount(_callback: Fetcher<GatekeeperConnectCallback>,
                       _options?: GatekeeperConnectOptions): Promise<{ url: string }> {
    throw new Error(NO_CONNECT_FLOW);
  }

  async getSupportedResources(_options?: { userId?: string }): Promise<SupportedResource[]> {
    return [COLLECTION_RESOURCE];
  }

  async getTypeScriptTypes(): Promise<string> {
    return TYPES_CODE;
  }
}

// ---------------------------------------------------------------------------
// Account

@validateRpc()
export class __Name__Account extends WorkerEntrypoint<Cloudflare.Env, AccountProps>
    implements GatekeeperUser {
  async describe(): Promise<AccountDescription> {
    return { displayName: "__title__ (synthetic data)", avatar: ICON };
  }

  async getSupportedResources(): Promise<SupportedResource[]> {
    return [COLLECTION_RESOURCE];
  }

  /**
   * Bind one collection this account can see. The scope is fixed in the binding's props here; no
   * session method takes a collection. An unknown collection is refused before anything is minted.
   */
  @skipRpcValidation()
  async getGatekeeperClassFor(url: string): Promise<{
    class: DurableObjectClass<Gatekeeper<any>>;
    resource: SupportedResource;
  }> {
    const { workspace, collectionId } = parseCollectionUrl(url);
    const { accountId } = this.ctx.props;
    if (!(await openClient(this.ctx.exports, accountId).hasCollection(collectionId))) {
      throw new Error(`No __title__ collection "${collectionId}" is available to this account.`);
    }
    const props: BindingProps = { accountId, workspace, collectionId };
    return { class: this.ctx.exports.__Name__CollectionGatekeeper({ props }), resource: COLLECTION_RESOURCE };
  }

  /** No picker yet: the resource URL is entered by hand. */
  @skipRpcValidation()
  async startResourceConfigurator(_resourceUrlPattern: string): Promise<ResourceConfiguratorFrame> {
    throw new Error("__title__ has no resource picker; enter __slug__://<workspace>/collection/<id>.");
  }

  /** Forget this account's data; its bindings then fail on their next call. */
  async revoke(): Promise<void> {
    await openClient(this.ctx.exports, this.ctx.props.accountId).forget();
  }

  async reconnect(): Promise<{ url: string }> {
    throw new Error(NO_CONNECT_FLOW);
  }

  async commitReconnect(_stageId: string): Promise<void> {
    throw new Error(NO_CONNECT_FLOW);
  }

  async getAuthenticatedEmail(): Promise<string | null> {
    return null;
  }

  /** No grantable resource types, so nothing to authorize. */
  async ensureResources(_resourceUrlPatterns: string[]): Promise<{ url?: string }> {
    return {};
  }

  @skipRpcValidation()
  async getVerifier(): Promise<Fetcher<GatekeeperUserVerifier>> {
    return this.ctx.exports.__Name__Verifier({ props: this.ctx.props });
  }
}

/** The verifier surface `addObserver` relies on; the overseer only hands it back to this vendor. */
export interface __Name__VerifierApi extends GatekeeperUserVerifier {
  /** Whether this account can see the collection, from its own data. */
  hasCollectionAccess(collectionId: string): Promise<boolean>;
}

@validateRpc()
export class __Name__Verifier extends WorkerEntrypoint<Cloudflare.Env, AccountProps>
    implements __Name__VerifierApi {
  async hasCollectionAccess(collectionId: string): Promise<boolean> {
    try {
      return await openClient(this.ctx.exports, this.ctx.props.accountId).hasCollection(collectionId);
    } catch (error) {
      // A disconnected observer has no access; any other failure is reported, not read as "no".
      if (errorCode(error) === "UNAUTHORIZED") return false;
      throw error;
    }
  }
}

// ---------------------------------------------------------------------------
// Collection gatekeeper (a facet of the overseer, one per binding)

@validateRpc()
export class __Name__CollectionGatekeeper extends DurableObject<Cloudflare.Env, BindingProps>
    implements Gatekeeper<__Name__CollectionSession> {
  readonly #journal = new ActionJournal<TaggedAction<Actions>>(this.ctx.storage.kv, { namespace: "items" });

  // One host per journal: the action set refuses to be rebound to a different one.
  readonly #host: Host = {
    client: openClient(this.ctx.exports, this.ctx.props.accountId),
    collectionId: this.ctx.props.collectionId,
    idempotencyKey: actionId => `${this.#bindingId()}:${actionId}`,
  };

  /** A random id for this binding, so two bindings of one account never share a key. */
  #bindingId(): string {
    let id = this.ctx.storage.kv.get<string>("binding-id");
    if (!id) this.ctx.storage.kv.put("binding-id", id = crypto.randomUUID());
    return id;
  }

  #actions() {
    return actions.bind(this.#journal, this.#host);
  }

  async describe(): Promise<ResourceDescription> {
    const { workspace, collectionId } = this.ctx.props;
    return {
      url: `__slug__://${workspace}/collection/${collectionId}`,
      title: `__title__ collection ${collectionId}`,
      snippet: `__title__ collection ${collectionId}: read its items and propose changes.`,
      suggestedBindingName: "__NAME___COLLECTION",
      tsType: "__Name__CollectionSession",
    };
  }

  async getTypeScriptTypes(): Promise<string> {
    return TYPES_CODE;
  }

  /** Every write waits for review; none is auto-approvable. */
  async getAutoApprovableActions(): Promise<ActionKind[]> {
    return [];
  }

  async startSession(approvalQueue: RpcStub<ApprovalQueue>): Promise<__Name__CollectionSession> {
    const queue = approvalQueue.dup();
    return new CollectionSessionImpl(this.#host, queue,
      payload => this.#actions().submit(queue, "updateItem", payload));
  }

  /** Strategy B: the binding is one collection, so admit an observer who can see that collection. */
  async addObserver(_id: string, user: Fetcher<GatekeeperUserVerifier>): Promise<void> {
    const verifier = user as unknown as Fetcher<__Name__VerifierApi>;
    if (!(await verifier.hasCollectionAccess(this.ctx.props.collectionId))) {
      throw new Error("This collaborator cannot see this __title__ collection, so they cannot observe " +
        "what a Gadget reads from it.");
    }
  }

  /** Nothing is tracked per observer under strategy B. */
  async removeObserver(_id: string): Promise<void> {}

  /** Applies once: the kit's journal answers a repeated apply of an applied action as a no-op. */
  async applyAction(actionId: number, _cache: RpcStub<GitCache>): Promise<void> {
    await this.#actions().apply(actionId);
  }

  async rejectAction(actionId: number): Promise<void> {
    await this.#actions().reject(actionId);
  }

  /** Submitted as not revertible. */
  async revertAction(_actionId: number):
      Promise<void | { message?: string; canRetry?: boolean; restart?: boolean }> {
    return { message: "__title__ changes are not revertible here; make a new change instead.", canRetry: false };
  }
}

// ---------------------------------------------------------------------------
// Session: what the agent holds

@validateRpc()
class CollectionSessionImpl extends RpcTarget implements __Name__CollectionSession {
  readonly #host: Host;
  readonly #queue: RpcStub<ApprovalQueue>;
  readonly #submit: (payload: Actions["updateItem"]) => Promise<number>;

  constructor(host: Host, queue: RpcStub<ApprovalQueue>,
              submit: (payload: Actions["updateItem"]) => Promise<number>) {
    super();
    this.#host = host;
    this.#queue = queue;
    this.#submit = submit;
  }

  [Symbol.dispose]() {
    this.#queue[Symbol.dispose]();
  }

  /** Runs one provider read, turning a provider refusal into the message the agent sees. */
  async #read<T>(read: () => Promise<T>): Promise<T> {
    try {
      return await read();
    } catch (error) {
      throw new Error(refusal(errorCode(error)), { cause: error });
    }
  }

  async listItems(): Promise<Item[]> {
    const { client, collectionId } = this.#host;
    const items = await this.#read(() => client.listItems(collectionId));
    await this.#queue.authorizeObservation({
      title: `Read __title__ collection ${collectionId}`,
      description: `Listed ${items.length} items.`,
    });
    return items;
  }

  async readItem(itemId: string): Promise<Item> {
    const { client, collectionId } = this.#host;
    const item = await this.#read(() => client.readItem(collectionId, itemId));
    await this.#queue.authorizeObservation({
      title: `Read __title__ item ${item.id}`,
      description: `Read item ${item.id} of collection ${collectionId}.`,
    });
    return item;
  }

  async updateItem(itemId: string, changes: ItemChanges, expectedRevision: Revision): Promise<void> {
    const title = changes.title?.trim();
    if (!title || title.length > MAX_TITLE || !/^\d+$/.test(expectedRevision)) {
      throw new Error(refusal("INVALID_REQUEST"));
    }
    const { client, collectionId } = this.#host;
    // Checked now so a wrong id fails here rather than at approval. Nothing read is returned, so
    // this is not an observation.
    await this.#read(() => client.readItem(collectionId, itemId));
    await this.#submit({ itemId, changes: { title }, expectedRevision });
  }
}
