{
  "$schema": "__SCHEMA__",
  "schemaVersion": 1,
  "id": "__slug__",
  "package": "__PACKAGE__",
  "status": "scaffold",
  "summary": "SCAFFOLD generated by pnpm gatekeepers:scaffold: one __title__ collection over a synthetic fake provider. Every read is an observation and every write an approved action. Not reviewed; not a real provider.",
  "entrypoints": {
    "main": "src/__slug__.ts",
    "vendor": "GatekeeperVendor",
    "account": "__Name__Account",
    "verifier": "__Name__Verifier",
    "durableObjects": ["__Name__FakeProvider", "__Name__CollectionGatekeeper"]
  },
  "resources": [
    {
      "kind": "collection",
      "urlPattern": "__slug__://*/collection/*",
      "gatekeeper": "__Name__CollectionGatekeeper",
      "session": "__Name__CollectionSession",
      "scope": "One collection the account can see, fixed in the binding's props when the Workshop mints it; no session method takes a collection. An item of another collection is refused exactly as an unknown one (NOT_FOUND).",
      "observers": "admission",
      "reads": [
        { "method": "listItems" },
        { "method": "readItem" }
      ],
      "writes": [
        { "method": "updateItem", "concurrency": "expected-revision", "idempotency": "provider-key", "revert": "never" }
      ]
    }
  ],
  "approval": {
    "autoApprovable": [],
    "fingerprint": false,
    "rejection": "Discards the staged action; a later apply of that id is refused.",
    "notes": "Every write is staged in the gatekeeper-kit action journal and submitted for approval; the agent waits for the decision (no simulation). Apply sends <binding id>:<action id> as the idempotency key, and a repeated apply of an applied action is a no-op."
  },
  "providerErrors": [
    { "code": "NOT_FOUND", "meaning": "The collection or item does not exist or is outside the binding's scope; the two are indistinguishable.", "retryable": false },
    { "code": "STALE_REVISION", "meaning": "The item changed after the write was proposed.", "retryable": false },
    { "code": "INVALID_REQUEST", "meaning": "The request was malformed.", "retryable": false },
    { "code": "UNAUTHORIZED", "meaning": "The account was disconnected.", "retryable": false },
    { "code": "UNAVAILABLE", "meaning": "The provider could not be reached or its response was lost. The action stays pending, and a retry sends the same idempotency key.", "retryable": true }
  ],
  "simulation": {
    "summary": "None: reads show the provider's state only, and every write waits for the decision.",
    "limits": []
  },
  "credentials": [],
  "compatibility": {
    "provider": {
      "name": "__title__ (synthetic fake provider)",
      "repository": "",
      "revision": null,
      "apiVersion": null,
      "notes": "SCAFFOLD: no real provider yet. Pin its API (revision or version, and any generated contract) when the client is replaced."
    },
    "inferos": { "gatekeeperApi": [__API_LEVEL__] },
    "contracts": []
  },
  "conformance": {
    "suite": "@gadgets/gatekeeper-kit/conformance",
    "tests": ["__tests__/conformance.test.ts"],
    "covered": {
      "collection": [
        "resource-scope", "observation", "sharing", "approval", "apply-once", "stale-revision",
        "server-error-retry", "lost-response-retry", "revocation"
      ]
    },
    "perConnector": []
  }
}
