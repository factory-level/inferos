  {
    "name": "a widget event drives a page effect through an explicit link",
    "why": "The board's completion reaches the page only because an attachment names the page, and the page then navigates. The object between them hears nothing.",
    "page": {
      "schemaVersion": 2, "id": "page-triage", "revision": "3", "title": "Triage",
      "children": ["group-1"],
      "attachments": [
        { "id": "on-triaged", "version": 1, "on": "triaged", "effect": { "kind": "navigate", "page": "page-operations" } }
      ],
      "nodes": [
        { "nodeType": "object", "id": "group-1", "title": "Queue", "columns": 1, "children": ["board-1"], "attachments": [] },
        {
          "nodeType": "widget", "id": "board-1", "kind": "inferops.project-board", "version": 1, "targetRef": "inferops://acme.operations/project/board/ENG", "size": "wide", "params": { "workflow": "software", "showCompleted": true },
